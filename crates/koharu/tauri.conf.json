{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/536664d1b34e1989dbd22705e2fde8b57b36aa0c/crates/tauri-schema-generator/schemas/config.schema.json",
  "productName": "kore-minit",
  "identifier": "kore-minit",
  "build": {
    "devUrl": "http://localhost:3000",
    "frontendDist": "../../packages/koharu/out",
    "beforeDevCommand": "bun run --filter @koharu/bridge build && bun run --parallel --filter @koharu/bridge --filter @koharu/app dev",
    "beforeBuildCommand": "bun run --filter @koharu/bridge build && bun run --filter @koharu/app build"
  },
  "app": {
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "create": false,
        "width": 1024,
        "height": 768,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "title": "kore-minit",
        "decorations": false,
        "transparent": false,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "license": "MIT OR Apache-2.0",
    "resources": ["../../LICENSE-MIT", "../../LICENSE-APACHE"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEzRjRDMTM3NzFCMkM4N0EKUldSNnlMSnhOOEgwRS9GaFI1WWx5S3lFdFprUUgvOHhDNXpySVE0UEJ0UUFTeWRHWkFHVTZvN0sK",
      "endpoints": ["https://github.com/chiraitori/kore-minit/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
